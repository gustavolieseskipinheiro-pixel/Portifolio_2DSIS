*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}


body{
    background: #dcdcdc;

    display: flex;
    justify-content: center;
    align-items: center;

    min-height: 100vh;
}


.container{
    display: flex;
    justify-content: center;
    align-items: center;

    gap: 25px;

    flex-wrap: wrap;

    padding: 30px;
}


.card{
    width: 250px;

    background: white;

    border-radius: 15px;

    padding: 20px;

    text-align: center;

    box-shadow: 0 0 10px rgba(0,0,0,0.3);

    transition: 0.4s;
}

.card:hover{

    transform: scale(1.05);

    box-shadow: 0 15px 30px rgba(0,0,0,0.7);

    cursor: pointer;
}

.card img{
    width: 100px;
    height: 100px;

    border-radius: 50%;

    margin-bottom: 15px;
}


.card h2{
    margin-bottom: 10px;
}


.card h4{
    margin-bottom: 8px;

    color: #222;
}

.card p{
    color: #555;

    font-size: 14px;

    line-height: 20px;
}
